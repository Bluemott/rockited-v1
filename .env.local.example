# WooCommerce Configuration
# Use subdomain for WordPress API server (e.g., api.rockited4d.com, shop.rockited4d.com)
# Update to HTTPS after SSL certificate is installed on Lightsail
WOOCOMMERCE_URL=https://api.rockited4d.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Configuration (use test keys for development: sk_test_*, pk_test_*)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret. For local testing: run Stripe CLI then use the secret from CLI output:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# For production: Stripe Dashboard > Webhooks > Your endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site Configuration
# Update to HTTPS after SSL certificate is installed
NEXT_PUBLIC_SITE_URL=https://rockited4d.com

# Stripe Branding
# Logo URL for Stripe Checkout branding (relative path from public folder or full URL)
# Default: /Rockited_Logo_For_Dark_BKGRND.png
STRIPE_LOGO_URL=/Rockited_Logo_For_Dark_BKGRND.png
# Stripe Tax (optional). Set to false to disable: STRIPE_TAX_ENABLED=false
# Test cards: https://docs.stripe.com/testing (e.g. 4242 4242 4242 4242 for success)

# Analytics
# Add your Google Analytics 4 Measurement ID when ready (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shippo Shipping (required for domestic US shipping + address validation). Get API key from https://goshippo.com (Dashboard > API).
# Without these, /api/shipping/calculate and /api/address/validate return "not configured". Test keys (shippo_test_*) work for rates; address validation may require a live key.
SHIPPO_API_KEY=
SHIPPO_ORIGIN_NAME=Your Store
SHIPPO_ORIGIN_STREET1=123 Main St
SHIPPO_ORIGIN_CITY=Anytown
SHIPPO_ORIGIN_STATE=CA
SHIPPO_ORIGIN_ZIP=90210
# SHIPPO_ORIGIN_COUNTRY=US
# Optional: USPS (or other) carrier account object ID from Shippo Dashboard > Carrier Accounts. Ensures rates from this carrier.
# SHIPPO_CARRIER_ACCOUNT_IDS=ee0d505fc8ee4dc886cc93133b2ce9da

# Address autocomplete (optional). Checkout "Search address" dropdown. Enable Places API + Maps JavaScript API in Google Cloud.
# Restrict key to HTTP referrers and add: http://localhost:3000/* and your production origin (e.g. https://yoursite.com/*).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
